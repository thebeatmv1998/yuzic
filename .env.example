# Copy to .env and adjust.
#
# .env is ignored by git and excluded from the Docker build context. Never
# commit it: it can contain upstream addresses and, below, authentication
# secrets.

# Port the yuzic web app is published on (direct HTTP mode).
YUZIC_PORT=8080

# The Navidrome (or any Subsonic-compatible) server you already run.
# In the app, connect to  http://<host>:<YUZIC_PORT>/navidrome
# With the TLS overlay, use https://<YUZIC_DOMAIN>/navidrome instead.
# Examples:
#   http://host.docker.internal:4533      (Navidrome on the Docker host)
#   http://navidrome:4533                 (a `navidrome` service in this compose)
#   http://192.168.1.10:4533              (another machine on the LAN)
NAVIDROME_UPSTREAM=http://host.docker.internal:4533

# The Downtify instance you already run.
# In the app, connect to  http://<host>:<YUZIC_PORT>/downtify
DOWNTIFY_UPSTREAM=http://host.docker.internal:8000

# ---------------------------------------------------------------------------
# Custom auth header at login (optional)
# ---------------------------------------------------------------------------
# nginx injects these headers into every request it proxies to the matching
# upstream: the login request, API calls and audio streams. The secret stays in
# the container and is never sent to the browser.
#
# Header names: letters, digits and hyphen only (max 64). Hop-by-hop headers,
# Host, Content-*, Cookie and X-Forwarded-* are rejected. Values: printable
# ASCII, max 4096, without quotes, backslash, dollar, semicolon or braces.
#
# Two headers per upstream are supported; Cloudflare Access needs exactly two.
# Example (Cloudflare Access service token):
#   NAVIDROME_HEADER_1_NAME=CF-Access-Client-Id
#   NAVIDROME_HEADER_1_VALUE=xxxxxxxx.access
#   NAVIDROME_HEADER_2_NAME=CF-Access-Client-Secret
#   NAVIDROME_HEADER_2_VALUE=yyyyyyyy...
#
# For production, prefer a Docker secret over a plain environment value:
# environment variables are readable with `docker inspect`. Mount the secret in
# docker-compose.yml and point VALUE_FILE at it:
#
#   services:
#     yuzic:
#       secrets:
#         - navidrome_header
#   secrets:
#     navidrome_header:
#       file: ./secrets/navidrome_header
#
#   NAVIDROME_HEADER_1_NAME=X-Api-Key
#   NAVIDROME_HEADER_1_VALUE_FILE=/run/secrets/navidrome_header
#
# Set VALUE or VALUE_FILE, never both. An empty NAME disables that slot.
NAVIDROME_HEADER_1_NAME=
NAVIDROME_HEADER_1_VALUE=
NAVIDROME_HEADER_1_VALUE_FILE=
NAVIDROME_HEADER_2_NAME=
NAVIDROME_HEADER_2_VALUE=
NAVIDROME_HEADER_2_VALUE_FILE=

DOWNTIFY_HEADER_1_NAME=
DOWNTIFY_HEADER_1_VALUE=
DOWNTIFY_HEADER_1_VALUE_FILE=
DOWNTIFY_HEADER_2_NAME=
DOWNTIFY_HEADER_2_VALUE=
DOWNTIFY_HEADER_2_VALUE_FILE=

# ---------------------------------------------------------------------------
# TLS overlay (docker-compose.tls.yml)
# ---------------------------------------------------------------------------
# Public hostname. With ports 80/443 reachable, Caddy gets a Let's Encrypt
# certificate automatically. For a LAN-only name, also set the internal
# Caddyfile below and trust Caddy's local root CA on your devices.
# YUZIC_DOMAIN=deck.example.com

# ./docker/Caddyfile           -> public CA (Let's Encrypt)
# ./docker/Caddyfile.internal  -> Caddy local CA, for LAN hostnames
# YUZIC_CADDYFILE=./docker/Caddyfile.internal
