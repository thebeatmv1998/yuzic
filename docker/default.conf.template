# yuzic web — nginx site.
#
# Substituted into /etc/nginx/conf.d/default.conf by the nginx-unprivileged
# entrypoint, which replaces the ${...} names below with the container's
# environment. `$host`, `$uri` and the rest are nginx run-time variables and
# are left alone (envsubst is limited to names actually present in the
# environment).
#
# The app is a single-page bundle, so anything that is not a real file falls
# back to index.html and the client-side router resolves it.

# HSTS only for HTTPS requests. The Caddy TLS overlay forwards the original
# scheme in X-Forwarded-Proto; a direct HTTP request leaves the header empty,
# and nginx omits empty add_header values.
map $http_x_forwarded_proto $hsts_header {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

# Access logs without the query string. Subsonic/Navidrome authentication puts
# a token and salt in `?u=...&t=...&s=...`, and cover/stream URLs inherit it;
# logging `$request` would write working credentials into every log line.
log_format yuzic '$remote_addr - $remote_user [$time_local] '
                 '"$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    access_log /var/log/nginx/access.log yuzic;

    # The app's own uploads and JSON bodies are small; a stream response is
    # unbounded but that is the response side, not the request side.
    client_max_body_size 8m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 30s;

    # Shared by every location that does not declare its own add_header.
    include /etc/nginx/snippets/security-headers.conf;

    # The entry bundle is several megabytes raw.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        application/javascript
        application/json
        application/wasm
        image/svg+xml
        text/css
        text/javascript
        text/plain;

    # Hashed build output — safe to cache forever. The security include is
    # repeated because a location-level add_header disables inheritance.
    location /_expo/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Fonts and images.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # The shell must never be cached, or a redeploy keeps serving the old app.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # --- Reverse proxies ---------------------------------------------------
    #
    # Same-origin access to the services the app talks to. Enter the matching
    # path as the server URL in yuzic, e.g.
    #
    #   Navidrome  ->  https://<your-yuzic-host>/navidrome
    #   Downtify   ->  https://<your-yuzic-host>/downtify
    #
    # Because the browser then sees one origin, neither service needs CORS
    # headers, and the stream/download URLs the app builds stay same-origin.
    #
    # The trailing slash on proxy_pass strips the prefix: a request for
    # /navidrome/rest/ping.view is proxied to <navidrome>/rest/ping.view.

    location /navidrome/ {
        proxy_pass ${NAVIDROME_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_redirect off;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;

        # Verify the upstream certificate when the upstream is HTTPS. The
        # directives are inert for the default http:// upstream. A self-signed
        # upstream needs its CA added to the image's trust store.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        # Generated at start-up from NAVIDROME_HEADER_*; the secret never
        # reaches the browser and covers login, API calls and audio streams.
        include /etc/nginx/upstream-headers/navidrome.conf;

        # Audio streams: hand bytes straight through rather than buffering them.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /downtify/ {
        proxy_pass ${DOWNTIFY_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_redirect off;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;

        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        include /etc/nginx/upstream-headers/downtify.conf;

        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Everything else: the SPA.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
