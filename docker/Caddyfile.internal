# Caddy TLS front end for a LAN-only deployment (no public domain).
#
# Caddy signs with its own local CA instead of Let's Encrypt. Install the
# generated root certificate on the devices that use the app, otherwise the
# browser shows a certificate warning:
#
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml \
#     exec caddy cat /data/caddy/pki/authorities/local/root.crt > yuzic-root.crt
#
# Then import yuzic-root.crt as a trusted root CA. The file is also kept in
# the `caddy_data` volume.
#
# Select this file with YUZIC_CADDYFILE=./docker/Caddyfile.internal in .env.
{
	admin off
}

{$YUZIC_DOMAIN:localhost} {
	tls internal
	encode zstd gzip

	reverse_proxy yuzic:8080 {
		header_up X-Real-IP {remote_host}
		header_down -Server
		header_down -X-Powered-By
	}
}
