# The container reads these files on Linux. Keep LF even when the repository is
# checked out on Windows: a CRLF shebang in a /docker-entrypoint.d script makes
# the container fail to start, and a CRLF nginx directive is a needless risk.
.gitattributes text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.env.example text eol=lf
docker/Caddyfile* text eol=lf
